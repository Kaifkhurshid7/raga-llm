# Copy to infra/.env and adjust.

# Backend
DATABASE_URL=postgresql://raga:raga@db:5432/raga

# Set to true for laptop-only development with no inference service
# running anywhere (returns a mock response instead of a real model call).
USE_MOCK_INFERENCE=true

INFERENCE_SERVICE_URL=http://inference-service:8001
DEFAULT_SERVING_CONDITION=baseline

# Inference service (GPU host only)
BASE_MODEL_ID=NousResearch/Meta-Llama-3.1-8B-Instruct
# Leave empty until finetuning/train_lora.py has actually been run:
LORA_ADAPTER_PATH=
